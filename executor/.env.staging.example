# Copy to executor/.env.staging and fill in before:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build
# Used for compose variable interpolation (container infrastructure credentials).

# Public hostname for the staging user API (Traefik Host rule).
# Point dev-api.haannaa.com at the server before starting the stack.
STAGING_USER_API_HOST=dev-api.haannaa.com

# The external docker network the host reverse proxy (Coolify traefik) is on.
PROXY_NETWORK=coolify

# Postgres — staging gets its OWN database and volume, isolated from production
POSTGRES_DB=haannaa-staging-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-staging-postgres

# Redis (audit queue)
REDIS_PASSWORD=change-me-staging-redis
