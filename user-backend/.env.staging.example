# Copy to user-backend/.env.staging and fill in before starting the staging
# stack (executor/docker-compose.staging.yml). DB/Redis connection values are
# overridden by compose — only secrets and origins matter here.

# Application Config (staging — enables the /api/v1/public/* directory API)
NODE_ENV=staging
PORT=3004
LOG_LEVEL=debug
APP_NAME=haannaa-user-backend
APP_URL=https://dev-api.haannaa.com
# Origins of the frontend(s) allowed to call this API, comma-separated
ALLOWED_ORIGIN="https://your-staging-frontend.vercel.app"

# Database Config (overridden by docker-compose.staging.yml)
DB_NAME=haannaa-staging-db
DB_USERNAME=postgres
DB_PASSWORD=change-me-staging-postgres
DB_WRITE_HOST=postgres
DB_PORT=5432

# Security Config — use strong, unique staging values
JWT_LOGIN_SECRET=change-me-staging-login-secret
JWT_LOGIN_TOKEN_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-staging-refresh-secret
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_SESSION_TIMEOUT=60
JWT_MAX_SESSIONS=5
HASHING_ROUNDS=10

# Redis Config (overridden by docker-compose.staging.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-staging-redis

# Audit events (BullMQ)
AUDIT_LOG_ENABLED=true
AUDIT_QUEUE_NAME=audit-logs

# Demo seeders (admin-backend side) use this password for staged demo owners
DEMO_PASSWORD=Demo@123
